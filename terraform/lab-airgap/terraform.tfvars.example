proxmox_api_url          = "https://192.168.1.147:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "REMPLACER"
proxmox_tls_insecure     = true

proxmox_node = "pve"
storage      = "nfs_vm"

# From scratch lab air-gap — voir terraform.tfvars.airgap.example pour le détail SNO
create_dns      = true
create_bastion  = true
create_registry = true
create_sno      = false

rhel_template        = "rhel-10-template"
registry_install_iso = ""

lab_bridge       = "vmbr1"
admin_bridge     = "vmbr0"
bastion_admin_ip = "192.168.1.144"

ssh_user = "bernard"
