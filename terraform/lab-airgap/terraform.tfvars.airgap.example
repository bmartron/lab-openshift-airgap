# Lab air-gap 4.22 — infra complète (dns + bastion + registry + SNO)
# cp terraform.tfvars.airgap.example terraform.tfvars
# OCP5 connecté : terraform/assisted-ocp-bma/ UNIQUEMENT — rien OCP5 ici.
# Templates : voir proxmox/rhel-cloudinit-template.md (rhel10-tpl + rhel10-nfs).

proxmox_api_url          = "https://192.168.1.147:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "REMPLACER"
proxmox_tls_insecure     = true

proxmox_node = "pve"

# Mix : dns/bastion → nfs_vm (template rhel10-nfs) ; registry/SNO → local-lvm (rhel10-tpl)
# Cloud-init = même datastore que l’OS (pas de variable séparée)
storage_infra = "nfs_vm"
storage_perf  = "local-lvm"

create_dns      = true
create_bastion  = true
create_registry = true
create_sno      = false   # SNO = ISO agent, pas ce template

rhel_template        = "rhel10-tpl"  # local-lvm → registry
rhel_template_infra  = "rhel10-nfs"  # nfs_vm → dns/bastion
registry_install_iso = ""            # vide = clone + virtio1 données

lab_bridge       = "vmbr1"
admin_bridge     = "vmbr0"
lab_gateway      = "172.16.10.1"
bastion_admin_ip = "192.168.1.144"

dns_ip      = "172.16.10.11"
bastion_ip  = "172.16.10.10"
registry_ip = "172.16.10.20"
sno_ip      = "172.16.10.100"

sno_vm_name           = "ocp-sno"
sno_agent_iso         = "nfs_iso:iso/agent.x86_64.iso"
sno_install_disk_gb   = 120
sno_lvms_disk_gb      = 100
sno_cpu_cores         = 8
sno_cpu_type          = "host"
sno_memory_mb         = 24576

ssh_user = "bernard"
