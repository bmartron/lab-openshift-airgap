# Registry seule — copier : cp terraform.tfvars.registry.example terraform.tfvars

proxmox_api_url          = "https://192.168.1.147:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "REMPLACER"
proxmox_tls_insecure     = true

proxmox_node = "pve"
storage      = "nfs_vm"

create_dns      = false
create_bastion  = false
create_registry = true
create_sno      = false

rhel_template        = ""
registry_install_iso = "nfs_iso:iso/rhel-10.x-x86_64-dvd.iso"

lab_bridge  = "vmbr1"
registry_ip = "172.16.10.20"
