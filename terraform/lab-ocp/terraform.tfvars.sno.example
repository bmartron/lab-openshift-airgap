# OpenShift SNO — cp terraform.tfvars.sno.example terraform.tfvars
# Infra VMs: ../lab-infra/

proxmox_api_url          = "https://192.168.1.147:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "REPLACE_ME"
proxmox_tls_insecure     = true

proxmox_node = "pve"
storage_perf = "local-lvm"
lab_bridge   = "vmbr1"

ocp_topology = "sno"

sno_vm_name   = "ocp-sno"
sno_ip        = "172.16.10.100"
sno_mac       = "BC:24:11:E1:8F:82" # must match ansible ocp_sno_mac
sno_cpu_cores = 8
sno_memory_mb = 24576

agent_iso       = "nfs_iso:iso/agent.x86_64.iso"
install_disk_gb = 120
lvms_disk_gb    = 100 # virtio1 → /dev/vdb; 0 to disable
cpu_type        = "host"
