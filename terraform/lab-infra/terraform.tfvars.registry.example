# Registry-only example — bpg/proxmox linked clone
# cp terraform.tfvars.registry.example terraform.tfvars

proxmox_api_url          = "https://192.168.1.147:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "REPLACE_ME"
proxmox_tls_insecure     = true

proxmox_node = "pve"

storage_perf = "local-lvm"

create_dns      = false
create_bastion  = false
create_registry = true

# rhel_template_id = 100  # rhel10-tpl
full_clone   = false
rhel_dvd_iso = "nfs_iso:iso/rhel-10.2-x86_64-dvd.iso"

lab_bridge  = "vmbr1"
registry_ip = "172.16.10.20"

ssh_user = "bernard"
# ssh_public_key_file = "/Users/YOUR_MAC_USER/.ssh/id_ed25519.pub"
