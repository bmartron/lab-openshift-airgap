# DNS maison — cluster ocp-bma / base home.arpa
# Box / Pi-hole / Unbound — PAS la VM dns lab 172.16.10.11.
#
# VIP Assisted (lab actuel) :
#   API VIP     = 192.168.1.49
#   Ingress VIP = 192.168.1.48
# Les nœuds peuvent rester en DHCP.

# API OpenShift
api.ocp-bma.home.arpa.        IN A    192.168.1.49
api-int.ocp-bma.home.arpa.    IN A    192.168.1.49

# Ingress (wildcard apps / console)
*.apps.ocp-bma.home.arpa.     IN A    192.168.1.48

# Optionnel : noms stables par nœud (réservations DHCP)
# ocp-bma-0.home.arpa.        IN A    192.168.1.xxx
# ocp-bma-1.home.arpa.        IN A    192.168.1.xxx
# ocp-bma-2.home.arpa.        IN A    192.168.1.xxx

# Test depuis le Mac :
#   dig +short api.ocp-bma.home.arpa @192.168.1.1
#   dig +short console-openshift-console.apps.ocp-bma.home.arpa @192.168.1.1
