# Paramètres cluster — Assisted connecté (LAN maison, pas lab air-gap)
# Copier en local si utile : cp cluster-params.env.example ~/lab/ocp-bma/cluster.env

# Console Red Hat Assisted Installer
OCP_CLUSTER_NAME=ocp-bma
OCP_BASE_DOMAIN=home.arpa

# FQDN dérivés (ne pas inventer d’autre suffixe)
OCP_API_FQDN=api.ocp-bma.home.arpa
OCP_API_INT_FQDN=api-int.ocp-bma.home.arpa
OCP_APPS_WILDCARD=*.apps.ocp-bma.home.arpa

# Réseau : Proxmox vmbr0 uniquement — pas vmbr1, pas bastion lab
OCP_NODE_BRIDGE=vmbr0
OCP_DNS=192.168.1.1
# Remplacer par l’IP de ta box si différente (Freebox, Livebox, etc.)

# VIP (LAN maison) — saisies Assisted Installer + DNS box
# Adapter le préfixe 192.168.1. si ton LAN diffère
OCP_API_VIP=192.168.1.49
OCP_INGRESS_VIP=192.168.1.48

# VMs Proxmox (Terraform)
OCP_ASSISTED_VM_PREFIX=ocp-bma-ai
OCP_ASSISTED_NODE_COUNT=3
