apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: ocp422
rendezvousIP: 172.16.10.100
additionalNTPSources:
- 172.16.10.11
hosts:
- hostname: ocp-sno-422
  interfaces:
  - name: ens18
    macAddress: "BC:24:11:E1:8F:82"
  # Proxmox VirtIO Block (virtio0) → /dev/vda ; LVMS virtio1 → /dev/vdb
  # Check on SNO: lsblk -o NAME,SIZE,TYPE,TRAN
  # Accepted values: /dev/vda or /dev/disk/by-path/... (not /dev/disk/by-id/)
  rootDeviceHints:
    deviceName: /dev/vda
  networkConfig:
    interfaces:
    - name: ens18
      type: ethernet
      state: up
      mac-address: BC:24:11:E1:8F:82
      ipv4:
        enabled: true
        dhcp: false
        address:
        - ip: 172.16.10.100
          prefix-length: 24
    dns-resolver:
      config:
        server:
        - 172.16.10.11
    routes:
      config:
      - destination: 0.0.0.0/0
        next-hop-address: 172.16.10.1
        next-hop-interface: ens18
        table-id: 254
