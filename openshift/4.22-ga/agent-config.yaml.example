apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: ocp422
rendezvousIP: 172.16.10.100
additionalNTPSources:
- 172.16.10.11
hosts:
- hostname: ocp-sno-422
  interfaces:
  - name: ens18
    macAddress: "BC:24:11:XX:XX:XX"
  # Proxmox SCSI (drive-scsi0) → /dev/sda ; VirtIO Block → /dev/vda
  # Vérifier sur le SNO : lsblk -o NAME,SIZE,TYPE,TRAN
  # Valeurs acceptées : /dev/sda ou /dev/disk/by-path/... (pas /dev/disk/by-id/)
  rootDeviceHints:
    deviceName: /dev/sda
  networkConfig:
    interfaces:
    - name: ens18
      type: ethernet
      state: up
      mac-address: BC:24:11:XX:XX:XX
      ipv4:
        enabled: true
        dhcp: false
        address:
        - ip: 172.16.10.100
          prefix-length: 24
    dns-resolver:
      config:
        server:
        - 172.16.10.11
    routes:
      config:
      - destination: 0.0.0.0/0
        next-hop-address: 172.16.10.1
        next-hop-interface: ens18
        table-id: 254
