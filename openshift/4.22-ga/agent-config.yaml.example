# Example agent-config for SNO (1 node). For 3 masters see agent-config.compact3.yaml.example.
# Prefer Ansible: ocp_topology: sno → role ocp_bastion_install templates.
apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: ocp422
rendezvousIP: 172.16.10.100
additionalNTPSources:
- 172.16.10.11
hosts:
- hostname: ocp-sno-422
  interfaces:
  - name: enp6s18
    macAddress: "BC:24:11:E1:8F:82"
  # Proxmox VirtIO Block: virtio0 (120G install) → by-path (stable); virtio1 = LVMS
  # On agent live: ls -l /dev/disk/by-path/  → pick the link to ../../vda (not vdb)
  # Prefer by-path over /dev/vda (multi-disk can ignore/mismatch deviceName)
  rootDeviceHints:
    deviceName: "/dev/disk/by-path/pci-0000:06:0a.0"
  networkConfig:
    interfaces:
    - name: enp6s18
      type: ethernet
      state: up
      mac-address: BC:24:11:E1:8F:82
      ipv4:
        enabled: true
        dhcp: false
        address:
        - ip: 172.16.10.100
          prefix-length: 24
    dns-resolver:
      config:
        server:
        - 172.16.10.11
    routes:
      config:
      - destination: 0.0.0.0/0
        next-hop-address: 172.16.10.1
        next-hop-interface: enp6s18
        table-id: 254
