apiVersion: v1
baseDomain: lab.local
metadata:
  name: ocp422
compute:
- name: worker
  replicas: 0
controlPlane:
  name: master
  replicas: 1
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 172.16.10.0/24
  networkType: OVNKubernetes
additionalTrustBundle: |
  -----BEGIN CERTIFICATE-----
  REMPLACER_PAR_CA_REGISTRY
  -----END CERTIFICATE-----
# Chemins oc-mirror v2 — aligner sur workspace/working-dir/cluster-resources/itms-oc-mirror.yaml
imageContentSources:
- source: quay.io/openshift-release-dev/ocp-release
  mirrors:
  - registry.lab.local:5000/ocp4-422/openshift/release-images
- source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
  mirrors:
  - registry.lab.local:5000/ocp4-422/openshift/release
platform:
  none: {}
pullSecret: '{"auths":{"registry.lab.local:5000":{"auth":"..."}}}'
sshKey: 'ssh-ed25519 AAAA... remplacer_par_votre_cle'
