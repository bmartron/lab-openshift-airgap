# Copier vers versions.env (non versionné) et adapter
# cp versions.env.example versions.env

# --- Infra ---
RHEL_VERSION=10.2
PROXMOX_BRIDGE_LAB=vmbr1
LAB_NETWORK=172.16.10.0/24

# --- Accès lab (Mac → Proxmox → VMs isolées) ---
PROXMOX_HOST=192.168.1.147
PROXMOX_USER=root
LAB_USER=bernard
LAB_SSH_JUMP=${PROXMOX_USER}@${PROXMOX_HOST}
# Bastion LAN (Mac → scp/ssh direct)
BASTION_ADMIN_IP=192.168.1.144

# IPs VMs infra (vmbr1)
DNS_IP=172.16.10.11
BASTION_IP=172.16.10.10
REGISTRY_IP=172.16.10.20

# --- OpenShift GA (stable) ---
OCP_GA_VERSION=4.22.12
OCP_GA_RELEASE=${OCP_GA_VERSION}-x86_64
OCP_GA_BASE_DOMAIN=ocp422.lab.local
OCP_GA_CLUSTER_NAME=ocp422
OCP_GA_MIRROR_PATH=ocp4-422
OCP_GA_SNO_IP=172.16.10.100

# --- OpenShift 5 RC (épingler le build ec précis) ---
OCP_RC_VERSION=5.0.0-ec.6
OCP_RC_RELEASE=${OCP_RC_VERSION}-x86_64
OCP_RC_BASE_DOMAIN=ocp5.lab.local
OCP_RC_CLUSTER_NAME=ocp5
OCP_RC_MIRROR_PATH=ocp5-rc
OCP_RC_SNO_IP=172.16.10.110

# --- Proxmox stockages NFS (IDs Datacenter → Storage) ---
PROXMOX_STORAGE_VM=nfs_vm
PROXMOX_STORAGE_ISO=nfs_iso

# --- Registry ---
REGISTRY_HOST=registry.lab.local
REGISTRY_PORT=5000
