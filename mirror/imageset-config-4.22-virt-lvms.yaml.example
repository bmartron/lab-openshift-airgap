# Platform + Virtualization + LVMS + update graph (OSUS).
# Default: single version. For upgrade lab, set min≠max (e.g. 4.22.0 → 4.22.12)
# so oc-mirror pulls both releases + Cincinnati graph into ocp4-422.
# Ansible: ocp_platform_min_version / ocp_platform_max_version (and operator min/max).
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.0
        maxVersion: 4.22.12
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
              minVersion: 4.22.0
              maxVersion: 4.22.9
        - name: lvms-operator
          channels:
            - name: stable-4.22
              minVersion: 4.22.0
              maxVersion: 4.22.0
        - name: cincinnati-operator
          channels:
            - name: v1
