# Platform + Virtualization + LVMS + update graph (OSUS).
# Platform: min≠max + shortestPath:true → upgrade path only.
# Operators: one package entry with channel min/max (duplicate packages rejected by oc-mirror).
# additionalImages: RHEL/CentOS guest container disks for Virt VM tests (~few GiB each; not DVD ISOs).
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.0
        maxVersion: 4.22.12
        shortestPath: true
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
              minVersion: 4.22.0
              maxVersion: 4.22.9
        - name: lvms-operator
          channels:
            - name: stable-4.22
              minVersion: 4.22.0
              maxVersion: 4.22.0
        - name: cincinnati-operator
          channels:
            - name: v1
  additionalImages:
    - name: registry.redhat.io/rhel9/rhel-guest-image:latest
    - name: registry.redhat.io/rhel10/rhel-guest-image:latest
    - name: quay.io/containerdisks/centos-stream:9
