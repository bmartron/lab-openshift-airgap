# Plateforme 4.22.12 + Virtualization + LVMS + update graph (OSUS).
# graph: true → graph-data image + UpdateService manifest (air-gap upgrades).
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
              minVersion: 4.22.9
              maxVersion: 4.22.9
        - name: lvms-operator
          channels:
            - name: stable-4.22
              minVersion: 4.22.0
              maxVersion: 4.22.0
        - name: cincinnati-operator
          channels:
            - name: v1
