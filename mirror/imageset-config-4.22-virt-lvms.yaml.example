# Lab default — platform single-pin + operators by channel (no CSV version pins).
# Prefer Ansible: ocp_imageset_profile=virt-lvms → regenerates ~/lab/4.22-ga/imageset-config.yaml
#
# Why no operator min/max: pinning a CSV that is missing from channel metadata
# breaks the pruned index (opm: "bundle ... not found in any channel entries").
# Channel-only stays consistent with the catalog; Subscription picks the channel head.
#
# Platform (as of 2026-11-18): 4.22.22
# Operators: Virt stable / LVMS stable-4.22 / OSUS v1 (whole channel)
#
# OpenShift 5: imageset-config-5.0-virt-lvms.yaml.example
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.22
        maxVersion: 4.22.22
        shortestPath: true
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
        - name: lvms-operator
          channels:
            - name: stable-4.22
        - name: cincinnati-operator
          channels:
            - name: v1
  additionalImages:
    - name: registry.redhat.io/rhel9/rhel-guest-image:latest
    - name: registry.redhat.io/rhel10/rhel-guest-image:latest
    - name: quay.io/containerdisks/centos-stream:9
