# Upgrade demo 4.22.22 → 5.0.1 + Virt / LVMS / OSUS — STEP 1 of 2 (base 4.22.22).
#
# Why 4.22.22 (not 4.22.12): release metadata for 5.0.1 only lists upgrades
# from 4.22.17 … 4.22.22 (and 5.0.0). A cluster on 4.22.12 cannot go to 5.0.1.
#
# Why two steps: oc-mirror cross-channel math walks 4.22 → 4.23 → 5.0.
# There is no stable-4.23, so both channels in one ImageSet fail with:
#   NoVersionsFound: ... "stable-4.23"
# Mirror STEP 1, then STEP 2 into the same registry path.
# STEP 2: imageset-config-4.22-to-5.0-upgrade-step2-5.0.yaml.example
#
# Lab flow after a standard 4.22.12 install:
#   1) mirror this file (4.22.22 + Virt/LVMS/OSUS)
#   2) mirror step2 (5.0.1 + Virt/LVMS/OSUS)
#   3) oc adm upgrade --to-image …4.22.22…
#   4) oc adm upgrade --to-image …5.0.1…
# Or install the demo cluster already at 4.22.22, then only step 4.
#
# Base pins (Day-2 on 4.22):
#   kubevirt-hyperconverged  stable / 4.22.9
#   lvms-operator            stable-4.22 / 4.22.0
#   cincinnati-operator      v1
#
# Not an Ansible profile. Copy to ~/lab/4.22-ga/imageset-config.yaml then:
#   oc-mirror -c imageset-config.yaml \
#     --workspace file://$HOME/lab/4.22-ga/workspace \
#     docker://registry.lab.local:5000/ocp4-422 \
#     --authfile ~/lab/pull-secret-oc-mirror.txt --v2
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.22
        maxVersion: 4.22.22
        shortestPath: true
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
              minVersion: 4.22.9
              maxVersion: 4.22.9
        - name: lvms-operator
          channels:
            - name: stable-4.22
              minVersion: 4.22.0
              maxVersion: 4.22.0
        - name: cincinnati-operator
          channels:
            - name: v1
