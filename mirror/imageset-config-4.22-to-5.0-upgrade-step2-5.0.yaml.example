# Upgrade demo 4.22.22 → 5.0.1 + Virt / LVMS / OSUS — STEP 2 of 2 (target 5.0).
# Run AFTER step 1 (imageset-config-4.22-to-5.0-upgrade.yaml.example) into the
# same registry path. Do not list both channels in one ImageSet (no 4.23).
#
# 5.0.1 accepts upgrades from 4.22.17 … 4.22.22 (not from 4.22.12).
# Reach 4.22.22 first, then upgrade to this release image.
#
# Target pins:
#   kubevirt-hyperconverged  stable / 5.0.0
#   lvms-operator            stable-5.0 (package defaultChannel on the v5.0 index)
#   cincinnati-operator      v1
# Filtering only "stable" for LVMS fails: oc-mirror requires the package
# default channel (or an explicit defaultChannel override).
#
# Copy over imageset-config.yaml on the bastion, then same oc-mirror command
# as step 1 (same workspace + docker://registry.lab.local:5000/ocp4-422).
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-5.0
        minVersion: 5.0.1
        maxVersion: 5.0.1
        shortestPath: true
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v5.0
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
              minVersion: 5.0.0
              maxVersion: 5.0.0
        - name: lvms-operator
          defaultChannel: stable-5.0
          channels:
            - name: stable-5.0
        - name: cincinnati-operator
          channels:
            - name: v1
