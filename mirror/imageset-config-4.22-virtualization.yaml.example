# Plateforme 4.22.12 + OpenShift Virtualization (kubevirt-hyperconverged).
# Channel catalogue = stable (défaut du package) — pas stable-4.22.
# Bastion 192.168.1.144 : si échec version, lister les bundles :
#   oc-mirror list operators --catalog=registry.redhat.io/redhat/redhat-operator-index:v4.22 \
#     --package=kubevirt-hyperconverged --v2
# Mirror lourd — nested virt : proxmox/network.md
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
              minVersion: 4.22.12
              maxVersion: 4.22.12
