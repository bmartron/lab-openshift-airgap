# Plateforme 4.22.12 + OpenShift Virtualization (kubevirt-hyperconverged).
# Mirror plus lourd que GitOps — nested virt sur les nœuds (voir proxmox/network.md).
# Bastion 192.168.1.144 : valider channel/version sur console.redhat.com pour OCP 4.22.12.
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable-4.22
              minVersion: 4.22.12
              maxVersion: 4.22.12
