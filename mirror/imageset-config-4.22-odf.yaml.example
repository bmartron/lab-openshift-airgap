# OCP 4.22.12 platform + OpenShift Data Foundation (odf-operator).
# Deploys Ceph via embedded Rook — target ≥ 3 nodes + dedicated OSD disks (not SNO lab).
# Prefer this profile: ODF embeds Rook-Ceph (no separate Rook operator mirror).
# Bastion 192.168.1.144:
#   oc-mirror list operators --catalog=registry.redhat.io/redhat/redhat-operator-index:v4.22 \
#     --package=odf-operator --authfile ~/lab/pull-secret-oc-mirror.txt --v2
# Align minVersion/maxVersion with catalog HEAD (e.g. 4.22.3-rhodf).
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: odf-operator
          channels:
            - name: stable-4.22
              minVersion: 4.22.3-rhodf
              maxVersion: 4.22.3-rhodf
