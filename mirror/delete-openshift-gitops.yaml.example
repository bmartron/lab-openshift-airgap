# Supprime les images opérateur GitOps précédemment poussées par oc-mirror.
# Ne pas mettre de section "platform" ici : le cluster SNO a besoin des images release.
#
# Workflow : mirror/README.md § Supprimer puis re-mirror GitOps (version épinglée)
---
apiVersion: mirror.openshift.io/v2alpha1
kind: DeleteImageSetConfiguration
delete:
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: openshift-gitops-operator
          # Sans channels : supprime tout ce package tel que découvert depuis le workspace
          # (équivalent au mirror « large »). Après delete, re-mirror avec channels/min/max.
