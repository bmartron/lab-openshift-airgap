# Size test — one OpenShift z-stream + one GPU Operator bundle.
# Not an Ansible profile. Copy over ~/lab/4.22-ga/imageset-config.yaml on the bastion.
# Do not re-run bastion-ocp-install.yml afterward: it regenerates that file.
#
# Platform 4.22.12 is the lab release (versions.md). Keep minVersion = maxVersion.
# gpu-operator-certified is in the certified index, channel stable.
# Head of stable on the 4.22 catalog (2026-11): 26.7.2.
# stable also lists every older bundle back to 1.10. Without min = max, oc-mirror
# pulls that whole history. One pinned bundle still mirrors its related images
# (NVIDIA driver / toolkit); those remain large.
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
    graph: false
  operators:
    - catalog: registry.redhat.io/redhat/certified-operator-index:v4.22
      packages:
        - name: gpu-operator-certified
          channels:
            - name: stable
              minVersion: 26.7.2
              maxVersion: 26.7.2
