# Platform 4.22.12 + GitOps (pinned channel).
# Alternatives: imageset-config-4.22-platform-only.yaml.example,
#               imageset-config-4.22-virt-lvms.yaml.example
# Copy on bastion 192.168.1.144: ~/lab/4.22-ga/imageset-config.yaml
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        # Without "channels", oc-mirror pulls ALL package versions from the index
        # (often 100+ operator images for GitOps alone) → registry disk + duration.
        - name: openshift-gitops-operator
          channels:
            - name: gitops-1.16
              minVersion: 1.16.5
              maxVersion: 1.16.5
        # Other operators: one block per package; always pin channel + version.
