# Plateforme 4.22.12 + opérateur Rook-Ceph seul (sans métier ODF).
# Usage rare sur OCP : préférer odf-operator (imageset-config-4.22-odf.yaml.example).
# Si tu choisis cette piste, ne miroir pas en plus odf-operator (doublon Ceph/Rook).
#   oc-mirror list operators --catalog=registry.redhat.io/redhat/redhat-operator-index:v4.22 \
#     --package=rook-ceph-operator --authfile ~/lab/pull-secret-oc-mirror.txt --v2
apiVersion: mirror.openshift.io/v1alpha2
kind: ImageSetConfiguration
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.22
        minVersion: 4.22.12
        maxVersion: 4.22.12
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: rook-ceph-operator
          channels:
            - name: stable-4.22
              minVersion: 4.22.3-rhodf
              maxVersion: 4.22.3-rhodf
