---
# cp hosts.yml.example hosts.yml
#
# SSH bernard@ (dns / bastion / registry) :
#   Clé Mac injectée par Terraform cloud-init — ssh_public_key_file dans
#   terraform/lab-infra/terraform.tfvars (see proxmox/rhel-cloudinit-template.md).
#   Plus besoin de ssh-copy-id bernard@… après un apply / recreate Terraform.
#
# Jump vers le lab (172.16.10.x) — choisir UNE méthode lab_jump_* :
#   A) Proxmox : clé SSH pour root@192.168.1.147 (ProxyJump) — une fois :
#        ssh-copy-id root@192.168.1.147
#   B) Bastion LAN : ProxyJump bernard@192.168.1.144 (même clé Mac)
#
all:
  vars:
    ansible_user: bernard
    lab_user: bernard

  children:
    lab_direct:
      hosts:
        bastion:
          ansible_host: 192.168.1.144   # IP LAN bastion (vmbr0) — lab NUC

    # Méthode A — jump Proxmox (recommandé si root@pve en clé)
    lab_jump_proxmox:
      vars:
        ansible_ssh_common_args: '-o ProxyJump=root@192.168.1.147'
      hosts:
        dns:
          ansible_host: 172.16.10.11
        registry:
          ansible_host: 172.16.10.20

    # Méthode B — jump bastion LAN (décommenter et commenter lab_jump_proxmox)
    # lab_jump_bastion:
    #   vars:
    #     ansible_ssh_common_args: '-o ProxyJump=bernard@192.168.1.144'
    #   hosts:
    #     dns:
    #       ansible_host: 172.16.10.11
    #     registry:
    #       ansible_host: 172.16.10.20
