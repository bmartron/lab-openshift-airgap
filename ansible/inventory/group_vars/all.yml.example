---
# cp all.yml.example inventory/group_vars/all.yml
# Single source of truth (ansible.cfg inventory = inventory/hosts.yml).
# Do not use ansible/group_vars/all.yml (removed).

lab_timezone: Europe/Paris
lab_ntp_server: 172.16.10.11

rhel_dvd_repo_enable: true
rhel_dvd_mount: /mnt/rhel
rhel_dvd_device: /dev/sr0   # ide0 DVD (BPG); ide2 = cloud-init — role probes all /dev/sr* if wrong

dns_ip: 172.16.10.11
registry_ip: 172.16.10.20
bastion_lab_ip: 172.16.10.10

registry_hostname: registry.lab.local
registry_port: 5000
registry_data_mount: /opt/registry
registry_data_device: /dev/vdb   # clone template virtio1 ; ISO Anaconda : /dev/sdb ou /dev/sdb1

registry_tls_mode: generate
registry_image_tar: /Users/bmartron/Downloads/registry2-amd64.tar

registry_deploy_container: true
registry_recreate_container: false

bastion_lab_dir: /home/bernard/lab
bastion_install_startup_check: true

# Install agent — ansible-playbook playbooks/bastion-ocp-install.yml
# Topology must match terraform/lab-ocp (sno | compact3)
ocp_topology: compact3
# compact3 → install-config platform baremetal + VIPs (free on 172.16.10.0/24)
ocp_api_vip: "172.16.10.50"
ocp_ingress_vip: "172.16.10.49"
# sno only (ignored for compact3 unless overriding node0 MAC):
# ocp_sno_mac: "bc:24:11:e1:8f:82"
# ocp_sno_root_device: "/dev/disk/by-path/pci-0000:06:0a.0"
# compact3 MACs/IPs: role defaults match terraform/lab-ocp (…:82/:83/:84)
ocp_sno_root_device: "/dev/disk/by-path/pci-0000:06:0a.0"  # shared rootDeviceHints for all masters
ocp_imageset_profile: virt-lvms   # platform-only | gitops | virt-lvms
# Upgrade lab — install min, upgrade to max (always set shortestPath):
# ocp_platform_version: "4.22.0"
# ocp_platform_min_version: "4.22.0"
# ocp_platform_max_version: "4.22.12"
# ocp_mirror_shortest_path: true   # required if min≠max (else every z-stream)
# Operators: one package + channel min/max (duplicate package entries are rejected):
# ocp_virt_operator_min_version: "4.22.0"
# ocp_virt_operator_max_version: "4.22.9"
# ocp_lvms_operator_min_version: "4.22.0"
# ocp_lvms_operator_max_version: "4.22.0"

ocp_agent_generate_iso: false          # true = run openshift-install on bastion
ocp_push_iso_to_proxmox: false        # true = scp agent.x86_64.iso to Proxmox NFS
