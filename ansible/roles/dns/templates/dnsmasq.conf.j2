# /etc/dnsmasq.conf — lab DNS VM ({{ dns_ip }})
# Managed by Ansible role dns — do not edit by hand on the VM.
interface={{ dns_interface }}
bind-interfaces
listen-address={{ dns_ip }}
listen-address=127.0.0.1
no-resolv
no-poll

# Air-gap: local resolution only (no upstream)
# server=8.8.8.8

domain={{ lab_domain }}
local=/{{ lab_domain }}/

address=/dns.{{ lab_domain }}/{{ dns_ip }}
address=/bastion.{{ lab_domain }}/{{ bastion_lab_ip }}
address=/{{ registry_hostname }}/{{ registry_ip }}
address=/registry.{{ lab_domain }}/{{ registry_ip }}

# OpenShift 4.22 GA (SNO)
address=/ocp-sno-422.{{ lab_domain }}/{{ ocp_sno_ip }}
address=/api.{{ ocp_cluster_name }}.{{ lab_domain }}/{{ ocp_sno_ip }}
address=/api-int.{{ ocp_cluster_name }}.{{ lab_domain }}/{{ ocp_sno_ip }}
address=/.apps.{{ ocp_cluster_name }}.{{ lab_domain }}/{{ ocp_sno_ip }}
