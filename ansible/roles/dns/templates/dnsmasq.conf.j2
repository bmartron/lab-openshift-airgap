# /etc/dnsmasq.conf — lab DNS VM ({{ dns_ip }})
# Managed by Ansible role dns — do not edit by hand on the VM.
interface={{ dns_interface }}
bind-interfaces
listen-address={{ dns_ip }}
listen-address=127.0.0.1
no-resolv
no-poll

# Air-gap: local resolution only (no upstream)
# server=8.8.8.8

domain={{ lab_domain }}
local=/{{ lab_domain }}/

address=/dns.{{ lab_domain }}/{{ dns_ip }}
address=/bastion.{{ lab_domain }}/{{ bastion_lab_ip }}
address=/{{ registry_hostname }}/{{ registry_ip }}
address=/registry.{{ lab_domain }}/{{ registry_ip }}

# OpenShift node hostnames
{% if ocp_topology | default('sno') == 'compact3' %}
{% for node in ocp_compact3_nodes %}
address=/{{ node.hostname }}.{{ lab_domain }}/{{ node.ip }}
{% endfor %}
{% else %}
address=/{{ ocp_sno_hostname | default('ocp-sno-422') }}.{{ lab_domain }}/{{ ocp_api_ip }}
{% endif %}

# API / apps — lab points at rendezvous / first master (no VIP yet)
address=/api.{{ ocp_cluster_name }}.{{ lab_domain }}/{{ ocp_api_ip }}
address=/api-int.{{ ocp_cluster_name }}.{{ lab_domain }}/{{ ocp_api_ip }}
address=/.apps.{{ ocp_cluster_name }}.{{ lab_domain }}/{{ ocp_api_ip }}
