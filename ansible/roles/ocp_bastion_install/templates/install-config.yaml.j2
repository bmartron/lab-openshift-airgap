apiVersion: v1
baseDomain: {{ ocp_base_domain }}
metadata:
  name: {{ ocp_cluster_name }}
compute:
- name: worker
  replicas: 0
controlPlane:
  name: master
  replicas: {{ ocp_control_plane_replicas | int }}
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 172.16.10.0/24
  networkType: OVNKubernetes
additionalTrustBundle: |
{% for line in ocp_registry_ca_pem.splitlines() %}
  {{ line }}
{% endfor %}
imageContentSources:
- source: quay.io/openshift-release-dev/ocp-release
  mirrors:
  - {{ ocp_registry_fqdn }}:{{ ocp_registry_port }}/{{ ocp_mirror_namespace }}/openshift/release-images
- source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
  mirrors:
  - {{ ocp_registry_fqdn }}:{{ ocp_registry_port }}/{{ ocp_mirror_namespace }}/openshift/release
platform:
  none: {}
pullSecret: '{{ ocp_pull_secret_json | replace("'", "''") }}'
sshKey: '{{ ocp_ssh_pubkey | replace("'", "''") }}'
