# /etc/dnsmasq.conf — DNS VM (172.16.10.11)
# Prefer Ansible role `dns` (interface eth0 on RHEL cloud-init / Proxmox VirtIO).
# Live file is rendered from ansible/roles/dns/templates/dnsmasq.conf.j2
interface=eth0
bind-interfaces
listen-address=172.16.10.11
listen-address=127.0.0.1
no-resolv
no-poll

# Air-gap: local resolution only (no upstream)
# server=8.8.8.8

domain=lab.local
local=/lab.local/

address=/dns.lab.local/172.16.10.11
address=/bastion.lab.local/172.16.10.10
address=/registry.lab.local/172.16.10.20

# OpenShift — compact3 (ocp_topology: compact3). For sno: ocp-sno-422 → .100 only.
address=/ocp-master-0.lab.local/172.16.10.100
address=/ocp-master-1.lab.local/172.16.10.101
address=/ocp-master-2.lab.local/172.16.10.102
address=/api.ocp422.lab.local/172.16.10.100
address=/api-int.ocp422.lab.local/172.16.10.100
address=/.apps.ocp422.lab.local/172.16.10.100

# Optional DHCP (disabled when all IPs are static)
# dhcp-range=172.16.10.50,172.16.10.99,255.255.255.0,12h
